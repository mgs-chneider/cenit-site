---
import { getLocale, getAltPath, localize } from "../i18n";

const pathname = Astro.url.pathname;
const locale = getLocale(pathname);
const altPath = getAltPath(pathname);
const dePath = locale === "de" ? pathname : altPath;
const enPath = locale === "en" ? pathname : altPath;

const l = (path: string) => localize(path, locale);

const labels =
  locale === "de"
    ? {
        menu: "Menü",
        home: "Home",
        vision: "Vision & Mission",
        about: "Über uns",
        expertise: "Expertise",
        contact: "Kontakt",
        insights: "Einblicke & Entwicklungen",
        facts: "Zahlen & Fakten",
        glossary: "Glossar",
        funding: "Förderaufrufe",
        faqs: "FAQs",
        statutes: "Satzung",
      }
    : {
        menu: "Menu",
        home: "Home",
        vision: "Vision & Mission",
        about: "About us",
        expertise: "Expertise",
        contact: "Contact",
        insights: "Insights & Updates",
        facts: "Facts & Figures",
        glossary: "Glossary",
        funding: "Funding Calls",
        faqs: "FAQs",
        statutes: "Statutes",
      };
---

<!-- CENIT TOP-BAR: Language | Social | Menu -->

<div class="cenit-topbar">
  <div class="cenit-topbar-inner">

    <div class="cenit-langswitch" aria-label="Language switch">
      <a class:list={["cenit-langbtn", { "is-active": locale === "de" }]} href={dePath}>DE</a>
      <span class="cenit-langsep">|</span>
      <a class:list={["cenit-langbtn", { "is-active": locale === "en" }]} href={enPath}>EN</a>
    </div>

    <a class="cenit-topbar-logo" href={l("/")} aria-label="CENIT Home">
      <img src="/assets/img/logo-cenit-transparent.png" alt="CENIT e.V." />
    </a>

    <button class="cenit-menutoggle" aria-expanded="false" aria-label="Menu">
      ☰ <span class="cenit-menulabel">{labels.menu}</span>
    </button>

  </div>

  <nav class="cenit-menu" aria-label="Site navigation">
    <div class="cenit-menu-group">
      <a class="cenit-menu-item cenit-menu-home" href={l("/")}>{labels.home}</a>
      <a class="cenit-menu-subitem" href={l("/#vision")}>{labels.vision}</a>
      <a class="cenit-menu-subitem" href={l("/#ueber-uns")}>{labels.about}</a>
      <a class="cenit-menu-subitem" href={l("/#expertise")}>{labels.expertise}</a>
      <a class="cenit-menu-subitem" href={l("/#kontakt")}>{labels.contact}</a>
    </div>

    <div class="cenit-menu-divider" role="separator" aria-hidden="true"></div>

    <a class="cenit-menu-item" href={l("/einblicke-entwicklungen")}>{labels.insights}</a>
    <a class="cenit-menu-item" href={l("/zahlen-fakten")}>{labels.facts}</a>
    <a class="cenit-menu-item" href={l("/glossar")}>{labels.glossary}</a>
    <a class="cenit-menu-item" href={l("/foerderaufrufe")}>{labels.funding}</a>
    <a class="cenit-menu-item" href={l("/faqs")}>{labels.faqs}</a>
    <a class="cenit-menu-item" href={l("/satzung")}>{labels.statutes}</a>
  </nav>
</div>
