---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { localize } from "../i18n";

interface Props {
  entry: CollectionEntry<"radar">;
  locale: "de" | "en";
}

const { entry, locale } = Astro.props;
const d = entry.data;

let glossarTitle: { de: string; en: string } | null = null;
if (d.glossarBegriff) {
  const glossarEntries = await getCollection("glossar");
  const target = glossarEntries.find((g) => g.data.slug === d.glossarBegriff!.slug);
  glossarTitle = target ? target.data.title : d.glossarBegriff.title;
}

const title = `CENIT Radar ${d.monthLabel} – ${d.title[locale]}`;
const description = d.indexTeaser[locale];
const canonical = `https://cenit-ev.de${localize(`/einblicke-entwicklungen/${d.slug}/`, locale)}`;

const labels =
  locale === "de"
    ? {
        breadcrumb: "← Einblicke & Entwicklungen",
        veranstaltung: "Veranstaltung des Monats",
        szeneKontext: "Szene & Kontext",
        forschung: "Forschung",
        glossarBegriff: "Glossar-Begriff des Monats",
        mehrImGlossar: "Mehr im Glossar →",
        imKalender: "Im Kalender",
        footnote:
          "Die Zusammenfassungen geben Studieninhalte in eigenen Worten wieder und ersetzen nicht die Lektüre der Originalpublikationen. Alle verlinkten Quellen sind peer-reviewed oder stammen von anerkannten Fachorganisationen.",
        back: "← Zurück zur Übersicht",
      }
    : {
        breadcrumb: "← Insights & Developments",
        veranstaltung: "Event of the Month",
        szeneKontext: "Scene & Context",
        forschung: "Research",
        glossarBegriff: "Glossary Term of the Month",
        mehrImGlossar: "More in the glossary →",
        imKalender: "In the Calendar",
        footnote:
          "Summaries paraphrase study content and do not replace reading the original publications. All linked sources are peer-reviewed or from recognised professional organisations.",
        back: "← Back to overview",
      };
---

<Layout title={title} canonical={canonical} description={description} bodyClass="page-einblicke">
  <section class="cenit-section">
    <div class="cenit-container">
      <p style="font-size:13px; color:var(--muted-foreground); margin-bottom:28px;">
        <a href={localize("/einblicke-entwicklungen/", locale)} style="color:var(--muted-foreground); text-decoration:none;">{labels.breadcrumb}</a>
      </p>
      <div class="cenit-card cenit-einblicke-panel reveal" style="--reveal-delay:80ms">
        <p style="font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--cenit-purple); margin:0 0 10px 0; font-weight:600;">
          CENIT Radar · {d.monthLabel}
        </p>
        <h1 class="cenit-h2 cenit-einblicke-title">{d.title[locale]}</h1>
        <p class="cenit-text-body cenit-einblicke-subtitle" style="color:var(--muted-foreground);">{d.subtitle[locale]}</p>
        <div style="height:1px; background:rgba(0,0,0,0.07); margin:22px 0;"></div>

        {d.highlight && (
          <>
            <h2 class="cenit-h3 cenit-einblicke-h" style="margin-top:0;">{labels.veranstaltung}</h2>
            <div class="cenit-softcard cenit-einblicke-quote" style="border-left:3px solid var(--cenit-gold); border-radius:0 18px 18px 0; padding:20px 22px;">
              <p style="font-size:11px; font-weight:600; letter-spacing:0.07em; text-transform:uppercase; color:var(--cenit-gold); margin:0 0 8px 0;">
                {d.highlight.kicker}
              </p>
              <p class="cenit-text-body" style="font-family:'EB Garamond',serif; font-style:italic; font-size:20px; line-height:1.3; color:var(--cenit-purple); margin:0 0 10px 0;">
                {d.highlight.title[locale]}
              </p>
              <p class="cenit-text-body cenit-einblicke-body" style="margin:0 0 14px 0;" set:html={d.highlight.body[locale]} />
              <a class="cenit-btn" href={d.highlight.linkHref} target="_blank" rel="noopener">{d.highlight.linkLabel[locale]}</a>
            </div>
          </>
        )}

        <h2 class="cenit-h3 cenit-einblicke-h">{labels.szeneKontext}</h2>
        {d.szeneKontext.map((entry) => (
          <div class="cenit-radar-entry">
            <p class="cenit-radar-kicker">{entry.kicker[locale]}</p>
            <h3 class="cenit-radar-headline">{entry.headline[locale]}</h3>
            <p class="cenit-text-body cenit-einblicke-body" style="margin:0 0 10px 0;" set:html={entry.body[locale]} />
            <a class="cenit-btn" href={entry.linkHref} target="_blank" rel="noopener">{entry.linkLabel}</a>
          </div>
        ))}

        <h2 class="cenit-h3 cenit-einblicke-h">{labels.forschung}</h2>
        {d.forschung.map((entry) => (
          <div class="cenit-radar-entry">
            <p class="cenit-radar-kicker">{entry.kicker[locale]}</p>
            <h3 class="cenit-radar-headline">{entry.headline[locale]}</h3>
            <p class="cenit-text-body cenit-einblicke-body" style="margin:0 0 10px 0;" set:html={entry.body[locale]} />
            {entry.citation && (
              <p style="font-size:12px; color:var(--muted-foreground); margin:0 0 10px 0; font-style:italic;">{entry.citation}</p>
            )}
            <a class="cenit-btn" href={entry.linkHref} target="_blank" rel="noopener">{entry.linkLabel}</a>
          </div>
        ))}

        {d.glossarBegriff && glossarTitle && (
          <>
            <h2 class="cenit-h3 cenit-einblicke-h">{labels.glossarBegriff}</h2>
            <div class="cenit-softcard cenit-einblicke-quote" style="border-left:3px solid var(--cenit-purple); border-radius:0 18px 18px 0; padding:20px 22px;">
              <p class="cenit-text-body" style="font-family:'EB Garamond',serif; font-style:italic; font-size:19px; line-height:1.3; color:var(--cenit-purple); margin:0 0 10px 0;">
                {glossarTitle[locale]}
              </p>
              <p class="cenit-text-body cenit-einblicke-body" style="margin:0 0 14px 0;" set:html={d.glossarBegriff.teaser[locale]} />
              <a class="cenit-btn" href={localize(`/glossar/${d.glossarBegriff.slug}/`, locale)}>{labels.mehrImGlossar}</a>
            </div>
          </>
        )}

        <h2 class="cenit-h3 cenit-einblicke-h">{labels.imKalender}</h2>
        <div style="max-width:var(--cenit-axis-760); margin:10px 0 0 0;">
          {d.kalender.map((k, i) => (
            <div class="cenit-radar-cal-row" style={i === d.kalender.length - 1 ? "border-bottom:none;" : undefined}>
              <div class="cenit-radar-cal-date">
                <span class="cenit-radar-cal-day">{k.day}</span>
                <span class="cenit-radar-cal-mon">{k.month}</span>
              </div>
              <div>
                <p style="font-size:14px; font-weight:600; color:var(--cenit-text); margin:0 0 2px 0;">{k.name}</p>
                <p style="font-size:13px; color:var(--muted-foreground); margin:0;">{k.location} · <a href={k.linkHref} target="_blank" rel="noopener" style="color:var(--cenit-purple);">{k.linkLabel}</a></p>
              </div>
            </div>
          ))}
        </div>

        <div style="height:1px; background:rgba(0,0,0,0.07); margin:32px 0 16px 0;"></div>
        <p style="font-size:12px; color:var(--muted-foreground); line-height:1.6; max-width:var(--cenit-axis-760);">{labels.footnote}</p>

        <p style="margin-top:24px; padding-top:20px; border-top:1px solid rgba(0,0,0,0.06);">
          <a href={localize("/einblicke-entwicklungen/", locale)} style="font-size:13px; color:var(--muted-foreground); text-decoration:none;">{labels.back}</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cenit-radar-entry {
    max-width: var(--cenit-axis-760);
    margin: 0 0 22px 0;
    padding: 0 0 22px 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .cenit-radar-entry:last-of-type { border-bottom: none; }
  .cenit-radar-kicker {
    font-size: 12px;
    color: var(--muted-foreground);
    font-style: italic;
    margin: 0 0 5px 0;
  }
  .cenit-radar-headline {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 19px;
    line-height: 1.3;
    color: var(--cenit-purple);
    margin: 0 0 8px 0;
  }
  .cenit-radar-cal-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .cenit-radar-cal-date {
    min-width: 48px;
    background: var(--cenit-soft);
    border-radius: 10px;
    padding: 6px 4px;
    text-align: center;
    flex-shrink: 0;
  }
  .cenit-radar-cal-day {
    display: block;
    font-size: 16px;
    font-weight: 600;
    color: var(--cenit-purple);
    line-height: 1;
  }
  .cenit-radar-cal-mon {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-foreground);
    margin-top: 3px;
  }
</style>
