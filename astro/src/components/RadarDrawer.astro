---
/**
 * Seitlicher Reiter "CENIT Radar" am rechten Rand, direkt unter der Topbar.
 * Schiebt ein Panel mit der aktuellen Ausgabe herein (Muster von
 * schneiderundcie.com übernommen). Inhalt kommt automatisch aus der
 * neuesten Datei in src/content/radar/ – bei einer neuen Ausgabe ist
 * hier nichts zu pflegen.
 * Ab Tablet-Breite (640px): seitlicher Reiter + Panel von rechts.
 * Auf dem Handy: kompakte Pille unten links (erscheint nach dem Hero,
 * wie der Scroll-to-top-Button) + Panel als Bottom-Sheet von unten.
 * Auf den Radar-Seiten selbst wird der Reiter nicht angezeigt.
 */
import { getLocale, localize } from "../i18n";
import { getLatestRadar } from "../radar";

const pathname = Astro.url.pathname;
const locale = getLocale(pathname);
const onRadarPage = pathname.includes("/einblicke-entwicklungen/radar-");

const issue = await getLatestRadar();
const d = issue?.data;

const MONTHS_EN: Record<string, string> = {
  Januar: "January", Februar: "February", "März": "March", April: "April",
  Mai: "May", Juni: "June", Juli: "July", August: "August",
  September: "September", Oktober: "October", November: "November", Dezember: "December",
};
const monthLabel = d
  ? locale === "de"
    ? d.monthLabel
    : d.monthLabel.replace(/^\S+/, (m) => MONTHS_EN[m] ?? m)
  : "";

const monthName = monthLabel.split(" ")[0];

const t =
  locale === "de"
    ? {
        tab: "CENIT Radar",
        label: "Aktuelle Ausgabe",
        close: "Schließen",
        event: "Veranstaltung des Monats",
        scene: "Szene & Kontext",
        research: "Forschung",
        term: "Begriff des Monats",
        cta: "Zur Ausgabe →",
        all: "Alle Ausgaben",
      }
    : {
        tab: "CENIT Radar",
        label: "Current issue",
        close: "Close",
        event: "Event of the month",
        scene: "Scene & Context",
        research: "Research",
        term: "Term of the month",
        cta: "Read the issue →",
        all: "All issues",
      };

const issueHref = d ? localize(`/einblicke-entwicklungen/${d.slug}/`, locale) : "";
const allHref = localize("/einblicke-entwicklungen/", locale);

const items = d
  ? [
      d.highlight && { cat: t.event, title: d.highlight.title[locale] },
      d.szeneKontext[0] && { cat: t.scene, title: d.szeneKontext[0].headline[locale] },
      d.forschung[0] && { cat: t.research, title: d.forschung[0].headline[locale] },
      d.glossarBegriff && { cat: t.term, title: d.glossarBegriff.title[locale] },
    ].filter(Boolean) as { cat: string; title: string }[]
  : [];
---

{d && !onRadarPage && (
  <div class="cenit-radar-drawer-root">
    <button
      type="button"
      class="cenit-radar-tab"
      aria-expanded="false"
      aria-controls="cenit-radar-drawer"
    >
      <span class="cenit-radar-tab-line" aria-hidden="true"></span>
      <span class="cenit-radar-tab-text">{t.tab}</span>
    </button>

    <button
      type="button"
      class="cenit-radar-pill"
      aria-expanded="false"
      aria-controls="cenit-radar-drawer"
    >
      <span class="cenit-radar-pill-dot" aria-hidden="true"></span>
      {t.tab} · {monthName}
    </button>

    <div class="cenit-radar-scrim" aria-hidden="true"></div>

    <aside
      id="cenit-radar-drawer"
      class="cenit-radar-drawer"
      role="dialog"
      aria-label={`${t.tab} · ${monthLabel}`}
      aria-hidden="true"
      inert
    >
      <div class="cenit-radar-sheet-handle" aria-hidden="true"></div>
      <div class="cenit-radar-drawer-inner">
        <div class="cenit-radar-drawer-top">
          <span class="cenit-radar-drawer-label">{t.label} · {monthLabel}</span>
          <button type="button" class="cenit-radar-close" aria-label={t.close}>✕</button>
        </div>

        <p class="cenit-radar-drawer-title">{d.title[locale]}</p>
        <div class="cenit-radar-drawer-divider" aria-hidden="true"></div>

        <ul class="cenit-radar-drawer-list">
          {items.map((item) => (
            <li>
              <p class="cenit-radar-drawer-cat">{item.cat}</p>
              <a href={issueHref} class="cenit-radar-drawer-link">{item.title}</a>
            </li>
          ))}
        </ul>

        <a href={issueHref} class="cenit-btn cenit-radar-drawer-cta">{t.cta}</a>
        <a href={allHref} class="cenit-radar-drawer-all">{t.all}</a>
      </div>
    </aside>
  </div>
)}

<script>
  const root = document.querySelector<HTMLElement>(".cenit-radar-drawer-root");
  if (root) {
    const triggers = root.querySelectorAll<HTMLButtonElement>(".cenit-radar-tab, .cenit-radar-pill");
    const pill = root.querySelector<HTMLButtonElement>(".cenit-radar-pill")!;
    const panel = root.querySelector<HTMLElement>(".cenit-radar-drawer")!;
    const scrim = root.querySelector<HTMLElement>(".cenit-radar-scrim")!;
    const close = root.querySelector<HTMLButtonElement>(".cenit-radar-close")!;
    let lastTrigger: HTMLButtonElement | null = null;

    const setOpen = (open: boolean) => {
      root.classList.toggle("is-open", open);
      document.body.classList.toggle("cenit-radar-open", open);
      triggers.forEach((b) => b.setAttribute("aria-expanded", String(open)));
      panel.setAttribute("aria-hidden", String(!open));
      panel.toggleAttribute("inert", !open);
      if (open) close.focus();
      else lastTrigger?.focus({ preventScroll: true });
    };

    triggers.forEach((b) =>
      b.addEventListener("click", () => {
        lastTrigger = b;
        setOpen(true);
      })
    );
    close.addEventListener("click", () => setOpen(false));
    scrim.addEventListener("click", () => setOpen(false));
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && root.classList.contains("is-open")) setOpen(false);
    });

    // Handy: Pille erst einblenden, wenn der Hero überwiegend durchgescrollt ist,
    // damit sie Claim und Vereinsnamen nicht überdeckt.
    const onScroll = () =>
      pill.classList.toggle("is-visible", window.scrollY > window.innerHeight * 0.6);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  /* Reiter ab Tablet-Breite, Pille nur auf dem Handy */
  .cenit-radar-pill{ display: none; }
  @media (max-width: 639px){
    .cenit-radar-tab{ display: none !important; }
    .cenit-radar-pill{ display: inline-flex; }
  }

  /* Reiter */
  .cenit-radar-tab{
    position: fixed;
    right: 0;
    top: calc(var(--cenit-topbar-height) + 40px);
    z-index: 1300; /* unter Topbar (1400) und Menü (1500) */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 20px 10px;
    border: 1px solid rgba(201,164,78,0.5);
    border-right: none;
    border-radius: 10px 0 0 10px;
    background: var(--cenit-purple);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(107,20,184,0.22);
    transition: transform 0.3s ease;
  }
  .cenit-radar-tab:hover{ transform: translateX(-4px); }
  .cenit-radar-tab:focus-visible{ outline: 2px solid var(--cenit-gold); outline-offset: 3px; }
  .is-open .cenit-radar-tab{ transform: translateX(100%); }
  .cenit-radar-tab-line{
    width: 1px;
    height: 24px;
    background: var(--cenit-gold);
  }
  .cenit-radar-tab-text{
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  /* Abdunkelung */
  .cenit-radar-scrim{
    position: fixed;
    inset: 0;
    z-index: 1300;
    background: rgba(107,20,184,0.06);
    backdrop-filter: blur(1px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .is-open .cenit-radar-scrim{ opacity: 1; pointer-events: auto; }

  /* Panel */
  .cenit-radar-drawer{
    position: fixed;
    right: 0;
    top: var(--cenit-topbar-height);
    bottom: 0;
    z-index: 1350;
    width: min(380px, 88vw);
    overflow-y: auto;
    background: #fafafa;
    border-left: 1px solid rgba(0,0,0,0.06);
    box-shadow: -12px 0 30px rgba(25,25,60,0.10);
    transform: translateX(100%);
    transition: transform 0.3s ease-out;
  }
  .is-open .cenit-radar-drawer{ transform: translateX(0); }
  @media (prefers-reduced-motion: reduce){
    .cenit-radar-tab, .cenit-radar-pill, .cenit-radar-scrim, .cenit-radar-drawer{ transition: none; }
  }

  .cenit-radar-drawer-inner{ padding: 40px 32px 48px; }
  .cenit-radar-drawer-top{
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .cenit-radar-drawer-label{
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cenit-purple);
  }
  .cenit-radar-close{
    margin-top: -4px;
    border: none;
    background: none;
    font-size: 16px;
    line-height: 1;
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .cenit-radar-close:hover{ color: var(--cenit-purple); }
  .cenit-radar-drawer-title{
    margin: 10px 0 0;
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 26px;
    line-height: 1.2;
    color: var(--cenit-purple);
  }
  .cenit-radar-drawer-divider{
    width: 48px;
    height: 2px;
    margin: 18px 0 26px;
    background: var(--cenit-gold);
  }
  .cenit-radar-drawer-list{
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cenit-radar-drawer-list li{
    padding: 0 0 20px;
    margin: 0 0 20px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .cenit-radar-drawer-list li:last-child{ border-bottom: none; margin-bottom: 8px; }
  .cenit-radar-drawer-cat{
    margin: 0 0 6px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cenit-gold);
  }
  .cenit-radar-drawer-link{
    display: block;
    font-size: 15px;
    line-height: 1.45;
    color: var(--cenit-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .cenit-radar-drawer-link:hover{ color: var(--cenit-purple); }
  .cenit-radar-drawer-cta{ display: inline-block; margin-top: 4px; }
  .cenit-radar-drawer-all{
    display: block;
    margin-top: 18px;
    font-size: 13px;
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .cenit-radar-drawer-all:hover{ color: var(--cenit-purple); text-decoration: underline; }

  .cenit-radar-sheet-handle{ display: none; }

  /* Bei offenem Panel: Scroll-to-top-Button ausblenden, Hintergrund nicht mitscrollen */
  :global(body.cenit-radar-open #scrollTopBtn){ opacity: 0 !important; pointer-events: none !important; }
  @media (max-width: 1023px){
    :global(body.cenit-radar-open){ overflow: hidden; }
  }

  /* ---------- Handy: Pille + Bottom-Sheet ---------- */
  @media (max-width: 639px){
    .cenit-radar-pill{
      position: fixed;
      left: 16px;
      bottom: calc(20px + env(safe-area-inset-bottom));
      z-index: 1300;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border: 1px solid rgba(201,164,78,0.5);
      border-radius: 999px;
      background: var(--cenit-purple);
      color: #fff;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      box-shadow: 0 6px 20px rgba(107,20,184,0.25);
      cursor: pointer;
      opacity: 0;
      transform: translateY(12px);
      pointer-events: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .cenit-radar-pill.is-visible{
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .is-open .cenit-radar-pill{ opacity: 0; pointer-events: none; }
    .cenit-radar-pill:focus-visible{ outline: 2px solid var(--cenit-gold); outline-offset: 3px; }
    .cenit-radar-pill-dot{
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--cenit-gold);
    }

    .cenit-radar-drawer{
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      max-height: 82dvh;
      border-left: none;
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -12px 30px rgba(25,25,60,0.14);
      transform: translateY(100%);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .is-open .cenit-radar-drawer{ transform: translateY(0); }
    .cenit-radar-sheet-handle{
      display: block;
      width: 40px;
      height: 4px;
      margin: 10px auto 0;
      border-radius: 2px;
      background: rgba(0,0,0,0.12);
    }
    .cenit-radar-drawer-inner{ padding: 22px 22px 32px; }
    .cenit-radar-drawer-title{ font-size: 23px; }
    .cenit-radar-drawer-list li{ padding-bottom: 16px; margin-bottom: 16px; }
    .cenit-radar-scrim{ background: rgba(25,25,60,0.18); }
  }
</style>
