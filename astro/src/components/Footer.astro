---
import { getLocale } from "../i18n";

const locale = getLocale(Astro.url.pathname);
---

<footer class="cenit-footer">
  <div class="cenit-footer-inner">
    <div class="cenit-footer-links">
      {locale === "de" ? (
        <span>
          <a href="/impressum/">Impressum</a>
          <span class="cenit-footer-sep">|</span>
          <a href="/datenschutz/">Datenschutz</a>
          <span class="cenit-footer-sep">|</span>
          <a href="#" onclick="if(window.cenitConsent){cenitConsent.show();} return false;">Cookie-Einstellungen</a>
        </span>
      ) : (
        <span>
          <a href="/en/legal-notice/">Legal Notice</a>
          <span class="cenit-footer-sep">|</span>
          <a href="/en/privacy/">Privacy</a>
          <span class="cenit-footer-sep">|</span>
          <a href="#" onclick="if(window.cenitConsent){cenitConsent.show();} return false;">Cookie Settings</a>
        </span>
      )}
    </div>
    <div class="cenit-footer-copy">
      © <span id="cenit-year"></span>
      CENIT – Verein zur Förderung interdisziplinärer Tanzmedizin e.V.
    </div>
    <p class="cenit-footer-note">
      {locale === "de" ? (
        <span>
          Website-Konzept und redaktionelle Verantwortung:
          Manfred G. Schneider
        </span>
      ) : (
        <span>
          Website concept and editorial responsibility:
          Manfred G. Schneider
        </span>
      )}
    </p>
  </div>
  <script is:inline>
    // Jahr automatisch setzen (build-safe)
    (function () {
      var y = document.getElementById("cenit-year");
      if (y) y.textContent = new Date().getFullYear();
    })();
  </script>

  <!-- ==========================================================
       CENIT Cookie-Einwilligung (eigenes Consent-Tool, siehe
       public/assets/js/consent.js). Gate: Google Analytics 4
       lädt erst nach Einwilligung ("googleAnalytics"), Infogram-
       Grafiken auf Zahlen & Fakten laden automatisch, sobald
       "infogram" zugestimmt wurde (main.js: autoLoadAllInfogramEmbeds).
  ========================================================== -->
  <script is:inline>
    window.cenitConsentConfig = { gaId: 'G-SP90GD9T33' };
  </script>
  <script is:inline defer src="/assets/js/consent.js"></script>

</footer>
