---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Facts & Figures – CENIT e.V."
  canonical="https://cenit-ev.de/en/zahlen-fakten/"
  description="Facts and figures on injury risk in dance and the economic case for prevention – with studies and cited sources."
  bodyClass="page-zahlen-fakten"
>
  <!-- =========================
       HERO EDITORIAL
       ========================= -->
  <section class="cenit-section cenit-zf-hero">
    <div class="cenit-axis-760 reveal" style="--reveal-delay:80ms">
      <h2 class="cenit-h2">
        
        <span data-lang="en">Facts &amp; Figures</span>
      </h2>
      <p class="cenit-editorial-lead">
        
        <span data-lang="en">When movement becomes strain – why prevention in dance matters.</span>
      </p>
      <!-- Divider: bitte auf eine definierte Klasse standardisieren -->
      <div class="cenit-divider--gold" aria-hidden="true"></div>
      <div class="cenit-zf-intro">
        
        <div data-lang="en">
          <p>
            Dance thrives on movement – yet behind every performance lies daily strain.
            Many dancers train beyond their limits because prevention is still not a standard
            part of dance education.
          </p>
          <p>
            In this video, we explain why, as a non-profit organization, we advocate for
            cross-disciplinary, dance-specific preventive care — and why sustainable prevention
            must become an integral part of dance education.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- =========================
       VIDEO SECTION
       ========================= -->

  <section class="cenit-section cenit-zf-video">
    <div class="cenit-container">
      <div class="cenit-zf-video-inner reveal" style="--reveal-delay:200ms;">
        <div class="cenit-video-frame">
          <!-- DE -->
          
          <!-- EN -->
          <video
            class="cenit-video"
            controls
            playsinline
            preload="metadata"
            poster="/video/still-martha-graham.png"
            data-lang="en"
          >
            <source src="/video/cenit-video-en.mp4" type="video/mp4">
          </video>
        </div>
      </div>
    </div>
  </section>
  <!-- =========================
       CHARTS
       ========================= -->

  <section class="cenit-section cenit-zf-charts">
     <div class="cenit-container">
       <div class="cenit-zf-transition">
         <h2 class="cenit-zf-chapter">
           
           <span data-lang="en">Injuries in dance – the data speaks clearly.</span>
         </h2>
       </div>

      <div class="cenit-zf-charts-inner">
        <div class="cenit-facts-grid">
          <!-- Chart 1 -->
          <div class="cenit-embed-card">
            <h3 class="cenit-chart-headline">Dance Injuries - by Cohort</h3>
            <!-- DE -->
            
            <!-- EN -->
            <div class="cenit-embed-consent" data-lang="en">
              <div
                class="cenit-embed-consent-box"
                data-embed-src="https://infogram.com/verletzungsraten-1hmr6g89z0e9z2n"
                data-embed-height="560"
              >
                <p class="cenit-embed-consent-kicker">Facts & Figures</p>
                <p class="cenit-embed-consent-text">
                  This data is presented as an interactive chart.
                  The content will only load after your consent.
                </p>
                <div class="cenit-embed-consent-actions">
                  <button type="button" class="cenit-embed-consent-btn" onclick="loadInfogramEmbed(this)">
                    Show chart
                  </button>
                  <a href="/en/privacy/" class="cenit-embed-consent-link">Privacy</a>
                </div>
              </div>
              <div class="cenit-zf-sources">
                <strong>Sources:</strong>
                <a href="https://gots.org/?s=kinder+tanzen" target="_blank" rel="noopener">GOTS</a> ·
                <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC11254869/" target="_blank" rel="noopener">PMC Review</a> ·
                <a href="https://pubmed.ncbi.nlm.nih.gov/33837002/" target="_blank" rel="noopener">PubMed Study</a> ·
                <a href="https://pubmed.ncbi.nlm.nih.gov/39906979/" target="_blank" rel="noopener">PubMed Prospective</a>
              </div>
            </div>
          </div>
          <!-- Chart 2 -->
          <div class="cenit-embed-card">
            <h3 class="cenit-chart-headline">Injury Areas - by Body Region</h3>
            <!-- DE -->
            
            <!-- EN -->
            <div class="cenit-embed-consent" data-lang="en">
              <div
                class="cenit-embed-consent-box"
                data-embed-src="https://infogram.com/verletzungsbereiche-1h7v4pdk85r384k"
                data-embed-height="560"
              >
                <p class="cenit-embed-consent-kicker">Facts & Figures</p>
                <p class="cenit-embed-consent-text">
                  This data is presented as an interactive chart.
                  The content will only load after your consent.
                </p>
                <div class="cenit-embed-consent-actions">
                  <button type="button" class="cenit-embed-consent-btn" onclick="loadInfogramEmbed(this)">
                    Show chart
                  </button>
                  <a href="/en/privacy/" class="cenit-embed-consent-link">Privacy</a>
                </div>
              </div>
              <div class="cenit-zf-sources">
                <strong>Sources:</strong>
                <a href="https://pubmed.ncbi.nlm.nih.gov/22390950/" target="_blank" rel="noopener">PubMed Injuries</a> ·
                <a href="https://pubmed.ncbi.nlm.nih.gov/8947396/" target="_blank" rel="noopener">PubMed Injury Patterns</a> ·
                <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC4900039/" target="_blank" rel="noopener">PMC Injury Characteristics</a>
              </div>
            </div>
          </div>
        </div><!-- /.cenit-facts-grid -->
      </div><!-- /.cenit-zf-charts-inner -->
    </div>
  </section>
  <!-- =========================
       ÖKONOMISCHER FALL (für Kostenträger)
       ========================= -->
  <section class="cenit-section cenit-zf-econ" id="kostentraeger">
    <div class="cenit-axis-760">
      <div class="cenit-zf-transition">
        <h2 class="cenit-zf-chapter">
          
          <span data-lang="en">Prevention pays off – for payers, too.</span>
        </h2>
      </div>

      <p class="cenit-zf-econ-intro">
        
        <span data-lang="en">
          Injury prevention is not only a health question but an economic one. For private and statutory payers, accident insurers, and health insurance funds, evidence from dance and competitive sport points the same way: structured prevention reduces not only injury risk but also downstream costs.
        </span>
      </p>

      <div class="cenit-zf-econ-row">
        <!-- Stat 1: tanzspezifisch -->
        <div class="cenit-zf-econ-card is-dark">
          <p class="cenit-zf-stat-number">−66 %</p>
          <p class="cenit-zf-stat-label">
            
            <span data-lang="en">Workers' compensation claims</span>
          </p>
          <p class="cenit-zf-stat-text">
            
            <span data-lang="en">In a professional modern dance company, three years of structured prevention and care work reduced new workers' compensation claims by 66%, lost workdays by 56%, and overall injury incidence by 34%.</span>
          </p>
          <p class="cenit-zf-stat-source">
            
            <span data-lang="en">Ojofeitimi &amp; Bronner, <em>J Dance Med Sci</em>, 2011 · <a href="https://doi.org/10.1177/1089313X1101500303" target="_blank" rel="noopener">doi.org/10.1177/1089313X1101500303</a></span>
          </p>
        </div>

        <!-- Stat 2: Leistungssport allgemein -->
        <div class="cenit-zf-econ-card">
          <p class="cenit-zf-stat-number">−19 %</p>
          <p class="cenit-zf-stat-label">
            
            <span data-lang="en">Health care costs</span>
          </p>
          <p class="cenit-zf-stat-text">
            
            <span data-lang="en">From competitive sport more broadly (not dance-specific): a structured prevention programme in US college athletics reduced injury-related clinic visits by 23% and associated health care costs by up to 19%.</span>
          </p>
          <p class="cenit-zf-stat-source">
            
            <span data-lang="en">Parisien et al., <em>Orthop J Sports Med</em>, 2021 · <a href="https://doi.org/10.1177/23259671211029898" target="_blank" rel="noopener">doi.org/10.1177/23259671211029898</a></span>
          </p>
        </div>
      </div>

      <p class="cenit-zf-econ-note">
        
        <span data-lang="en">
          These figures come from individual studies and cannot be directly transferred to every institution – but they point in a consistent direction: investment in prevention often pays for itself through lower downstream costs. CENIT e.V. welcomes professional dialogue with payers, insurers, and public institutions on this topic.
        </span>
      </p>

      <p class="cenit-zf-econ-example">
        
        <span data-lang="en">
          A practical example: the VBG (Verwaltungs-Berufsgenossenschaft), Germany's statutory accident insurer for the stage and studio sector, already provides its own dance injury-prevention training module for teachers –
          <a href="https://www.vbg.de/cms/buehnen-und-studios/praevention-fuer-tanz" target="_blank" rel="noopener">Prevention for Dance, VBG
            <svg class="cenit-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </a>.
        </span>
      </p>
    </div>
  </section>
  <!-- =========================
       OUTRO / QUOTE BAND
       ========================= -->
  <section class="cenit-section cenit-zf-outro">
    <div class="cenit-axis-760 reveal" style="--reveal-delay:80ms; text-align:center;">
      <h3 class="cenit-zf-quote">
        
        <span data-lang="en">“Dancing healthy isn’t luck – it’s a decision.”</span>
      </h3>
      <div class="cenit-divider-gold-32" aria-hidden="true"></div>
      <p class="cenit-zf-quote-sub">
        
        <span data-lang="en">We move knowledge – together</span>
      </p>
    </div>
  </section>

</Layout>

<style>
  /* Ökonomischer Fall / Kostenträger-Sektion (lokal, kein Eingriff in main.css) */
  .cenit-zf-econ-intro{
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0 0 22px 0;
  }

  /* Kachellogik wie FAQ/Glossar: weißer Außenrahmen, helle/dunkle Innenkarten */
  .cenit-zf-econ-row{
    background: #ffffff;
    border-radius: 22px;
    padding: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 18px;
  }
  @media (max-width: 640px){
    .cenit-zf-econ-row{ grid-template-columns: 1fr; }
  }
  .cenit-zf-econ-card{
    background: #f5f3f9;
    border-radius: 18px;
    padding: 20px 22px;
    box-shadow: none;
  }
  .cenit-zf-econ-card.is-dark{ background: #edebf5; }

  .cenit-zf-stat-number{
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 26px;
    line-height: 1;
    color: var(--cenit-purple);
    margin: 0 0 4px 0;
  }
  .cenit-zf-stat-label{
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cenit-gold);
    margin: 0 0 10px 0;
  }
  .cenit-zf-stat-text{
    font-size: 13px;
    line-height: 1.55;
    color: var(--cenit-text);
    margin: 0 0 10px 0;
  }
  .cenit-zf-stat-source{
    font-size: 11.5px;
    font-style: italic;
    color: var(--muted-foreground);
    margin: 0;
  }
  .cenit-zf-econ-note{
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0;
    text-align: center;
  }
  .cenit-zf-econ-example{
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 10px 0 0 0;
    text-align: center;
  }
  .cenit-zf-econ-example a{
    color: var(--cenit-purple);
    text-decoration: none;
    font-weight: 600;
  }
  .cenit-zf-econ-example a:hover{
    text-decoration: underline;
  }
  .cenit-arrow-icon{
    width: 0.85em;
    height: 0.85em;
    margin-left: 4px;
    vertical-align: -0.05em;
    display: inline-block;
  }
</style>
