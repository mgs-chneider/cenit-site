---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Statutes & Mission Statement – CENIT e.V."
  canonical="https://cenit-ev.de/en/satzung/"
  description="Statutes and mission statement of CENIT e.V. – the legal foundation and values of the association for interdisciplinary dance medicine."
  bodyClass="page-satzung"
>
<!-- =========================
     SATZUNG – INTRO / HERO IMAGE (internal)
========================= -->
<section class="cenit-section page-satzung-hero">
  <div class="cenit-container">
    <div class="cenit-heroimg reveal" style="--reveal-delay:0ms">
      <img
        src="/assets/img/hero-stepptanz.jpg"
        alt="Abstract black and white dance photography"
        loading="eager">
      <div class="cenit-heroimg-overlay">
        <h1 class="cenit-heroimg-title reveal" style="--reveal-delay:140ms">
          
          <span data-lang="en">Statutes &amp; Mission Statement</span>
        </h1>
        <p class="cenit-lead reveal" style="--reveal-delay:220ms; text-align:left; margin:0;">
          
          <span data-lang="en">
            The statutes form the legal and organizational foundation of CENIT e.V.
            They define purpose, structure, and principles of our non-profit work.
          </span>
        </p>
      </div>
    </div>
  </div>
</section>
      <!-- Panel A: 3 Kacheln (wie Webador) -->
      <div class="cenit-stat-panel reveal" style="--reveal-delay:80ms">
        <div class="cenit-stat-tiles3">
          <div class="cenit-stat-tile is-soft">
            <h3 class="cenit-stat-tile-title">
              
              <span data-lang="en">Purpose of the association</span>
            </h3>
            <p class="cenit-text" style="margin:0;">
              
              <span data-lang="en">
                CENIT promotes health-oriented prevention in dance—especially through knowledge transfer,
                support for research, and connecting science, practice, and institutions.
              </span>
            </p>
          </div>
          <div class="cenit-stat-tile is-soft">
            <h3 class="cenit-stat-tile-title">
              
              <span data-lang="en">Non-profit status</span>
            </h3>
            <p class="cenit-text" style="margin:0;">
              
              <span data-lang="en">
                As a non-profit association, we use funds exclusively for statutory purposes—
                not for economic self-interest.
              </span>
            </p>
          </div>
          <div class="cenit-stat-tile is-soft">
            <h3 class="cenit-stat-tile-title">
              
              <span data-lang="en">Responsibility &amp; transparency</span>
            </h3>
            <p class="cenit-text" style="margin:0;">
              
              <span data-lang="en">
                Bodies, responsibilities, and decision-making processes are clearly defined—for reliable and transparent structures.
              </span>
            </p>
          </div>
        </div>
      </div>
      <!-- Panel B: 2 breite Cards (wie Webador) -->
      <div class="cenit-stat-panel reveal" style="--reveal-delay:140ms">
        <div class="cenit-stat-tiles2">
          <div class="cenit-stat-tile is-white">
            <h3 class="cenit-stat-tile-title">
              
              <span data-lang="en">Read or download the statutes</span>
            </h3>
            <p class="cenit-text" style="margin:0 0 12px 0;">
              
              <span data-lang="en">
                Here you can view the full statutes of CENIT e.V. The document opens in a new tab and can be read or downloaded there.
              </span>
            </p>
            <a class="cenit-btn cenit-btn--light"
               href="https://primary.jwwb.nl/plugin-documents/e95efef31060876bc35abee90d0717e1ee419c0e.pdf"
               target="_blank" rel="noopener">
              
              <span data-lang="en">Open PDF</span>
            </a>
          </div>
          <div class="cenit-stat-tile is-white">
            <h3 class="cenit-stat-tile-title">
              
              <span data-lang="en">View statutes as PDF</span>
            </h3>
            <p class="cenit-text" style="margin:0 0 12px 0;">
              
              <span data-lang="en">
                The statutes open directly in your browser. You can read them comfortably or download them.
              </span>
            </p>
            <a class="cenit-btn cenit-btn--light"
               href="https://primary.jwwb.nl/plugin-documents/e95efef31060876bc35abee90d0717e1ee419c0e.pdf"
               target="_blank" rel="noopener">
              
              <span data-lang="en">View now</span>
            </a>
            <p class="cenit-stat-muted">
              
              <span data-lang="en">Version: 2025</span>
            </p>
          </div>
        </div>
      </div>

  <!-- =========================
     LEITBILD (ANCHOR)
========================= -->

  <a id="leitbild"></a>
  <section class="cenit-section">
    <div class="cenit-container">
      <!-- Leitbild als 950px Panel im FAQ-Stil -->
      <div class="cenit-stat-panel cenit-stat-leitbild reveal" style="--reveal-delay:80ms">
        <h2 class="cenit-h2 cenit-stat-leitbild-title">
          
          <span data-lang="en">Mission Statement · CENIT e.V.</span>
        </h2>
        <div class="cenit-stat-leitbild-inner" style="text-align:center;">
          <p class="cenit-lead cenit-stat-leitbild-lead">
            
            <span data-lang="en">
              Vision: We are committed to making prevention in dance a natural part of health culture—across
              institutions, generations, and communities.
            </span>
          </p>
          <p class="cenit-lead cenit-stat-leitbild-lead" style="margin:0 0 22px 0;">
            
            <span data-lang="en">
              Our mission is to make the scientific foundations of dance injury prevention visible, enable research,
              and curate and disseminate evidence-based knowledge—so that structures emerge that make healthy
              dancing possible for everyone.
            </span>
          </p>
          <div class="cenit-hero-divider cenit-hero-divider--small"></div>
        </div>
        <!-- Content: linksbündig, max 820 -->
        <div class="cenit-stat-leitbild-inner" style="text-align:left; margin-top:18px;">
          <h3 class="cenit-h3" style="margin:22px 0 10px 0;">
            
            <span data-lang="en">Why CENIT exists</span>
          </h3>
          <p style="margin:0;">
            
            <span data-lang="en">
              Dance is art, expression, movement, and profession—but above all, part of everyday culture.
              People of all ages dance: recreational dancers, children, students, professionals, older adults,
              dance educators, and entire training structures.
            </span>
          </p>
          <p style="margin:10px 0 0 0;">
            
            <span data-lang="en">
              Yet the physical demands are high—and prevention is not yet a systemic part of the dance landscape.
            </span>
          </p>
          <h3 class="cenit-h3" style="margin:22px 0 10px 0;">
            
            <span data-lang="en">What we want to change</span>
          </h3>
          <p style="margin:0;">
            
            <span data-lang="en">
              We want injuries and overuse problems to be prevented before they occur—and we want dancers,
              regardless of background, to have access to effective, evidence-based prevention.
            </span>
          </p>
          <p style="margin:10px 0 0 0;">
            
            <span data-lang="en">
              This is our non-profit purpose: promoting prevention in dance for the benefit of the public.
            </span>
          </p>
          <h3 class="cenit-h3" style="margin:22px 0 10px 0;">
            
            <span data-lang="en">How we achieve this</span>
          </h3>
          <p style="margin:0 0 12px 0;">
            
            <span data-lang="en">CENIT drives change along three axes:</span>
          </p>
          <!-- Axis 1 -->
          <div class="cenit-stat-axis is-soft">
            <p class="cenit-stat-axis-title">
              
              <span data-lang="en">1. Knowledge &amp; awareness</span>
            </p>
            <ul class="cenit-stat-list">
              <li>
                
                <span data-lang="en">Curating and teaching the fundamentals of prevention in dance medicine</span>
              </li>
              <li>
                
                <span data-lang="en">Accessible information and education offers for all dancers</span>
              </li>
              <li>
                
                <span data-lang="en">Making scientific evidence visible</span>
              </li>
            </ul>
          </div>
          <!-- Axis 2 -->
          <div class="cenit-stat-axis is-soft">
            <p class="cenit-stat-axis-title">
              
              <span data-lang="en">2. Structures &amp; collaboration</span>
            </p>
            <ul class="cenit-stat-list">
              <li>
                
                <span data-lang="en">Supporting collaborations with institutions, research groups, and prevention centers</span>
              </li>
              <li>
                
                <span data-lang="en">Promoting conditions that make prevention in dance easier</span>
              </li>
              <li>
                
                <span data-lang="en">Contributing to sustainable structures (without any regulatory mandate)</span>
              </li>
            </ul>
          </div>
          <!-- Axis 3 -->
          <div class="cenit-stat-axis is-soft">
            <p class="cenit-stat-axis-title">
              
              <span data-lang="en">3. Research &amp; evidence</span>
            </p>
            <ul class="cenit-stat-list">
              <li>
                
                <span data-lang="en">Supporting projects and collaborations focused on prevention in dance</span>
              </li>
              <li>
                
                <span data-lang="en">Collecting, curating, and providing existing scientific evidence</span>
              </li>
              <li>
                
                <span data-lang="en">Connecting relevant institutions and partners</span>
              </li>
            </ul>
          </div>
          <h3 class="cenit-h3" style="margin:22px 0 10px 0;">
            
            <span data-lang="en">What CENIT does NOT do</span>
          </h3>
          <p style="margin:0 0 10px 0;">
            
            <span data-lang="en">To avoid misunderstandings—and to protect our non-profit status:</span>
          </p>
          <ul class="cenit-stat-list">
            <li>
              
              <span data-lang="en">We do not represent any professional group.</span>
            </li>
            <li>
              
              <span data-lang="en">We do not advise individual professional dancers as a trade association would.</span>
            </li>
            <li>
              
              <span data-lang="en">We do not engage in professional policy advocacy.</span>
            </li>
            <li>
              
              <span data-lang="en">We do not define mandatory quality standards and we are not a certification body.</span>
            </li>
          </ul>
          <h3 class="cenit-h3" style="margin:22px 0 10px 0;">
            
            <span data-lang="en">What we do instead</span>
          </h3>
          <p style="margin:0;">
            
            <span data-lang="en">
              We strengthen prevention across the entire dance field—from early childhood to older adulthood, from amateurs to
              professionals, from dance education to recreational dance.
            </span>
          </p>
          <p class="cenit-stat-muted">
            
            <span data-lang="en">Berlin, 22 November 2025 · The Board</span>
            <br>
            
            <span data-lang="en">Dr. Christiane Theobald · Prof. Dr. Herbert Schuster · Manfred G. Schneider</span>
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
