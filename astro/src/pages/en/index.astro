</Layout>

<style>
  /* Zahlen & Fakten – Teaser-Sektion (lokal, kein Eingriff in main.css) */
  .cenit-zf-teaser{
    margin-top: 36px;
  }
  /* Vision & Mission war früher die erste Sektion nach dem Hero und hat dafür in main.css
     einen großzügigen Sonder-Abstand (padding-top: clamp(120px,14vh,220px)). Jetzt sitzt die
     Zahlen & Fakten-Sektion dazwischen – V&M bekommt daher wieder das normale Section-Padding,
     damit der Abstand zu den übrigen Sektionsübergängen passt. */
  body.page-home #vision{
    padding-top: var(--cenit-section-py);
  }
  @media (max-width: 600px){
    body.page-home #vision{
      padding-top: var(--cenit-section-py-mobile);
    }
  }

  /* Hero-Claim ist jetzt eine kurze, einzeilige Aussage. Der 28ch-Cap in main.css war für
     den früheren, bewusst zweizeiligen Claim gedacht und erzwingt hier einen unnötigen
     Umbruch. Lokal aufgehoben – auf schmalen Screens bricht der Text bei Bedarf weiterhin
     ganz normal um. */
  body.page-home .cenit-hero-home-claim{
    max-width: none;
    /* Der dunkle Blur-Schatten aus main.css (0 2px 10px rgba(0,0,0,0.22)) wirkte
       auf dem kursiven Violett wie ein grauer Schmutzrand. Der Claim sitzt seit der
       Kürzung auf eine Zeile ohnehin im bereits stark aufgehellten unteren Bereich
       des Hero-Verlaufs – der Kontrast reicht auch ohne Schatten. */
    text-shadow: none;
  }

  /* Sub-Zeile (vollständiger Vereinsname): ruhige Signatur statt zweiter Schlagzeile.
     Gewicht reduziert (600 → 500), Farbe auf muted-foreground statt dunklem Fließtext –
     bleibt bei ausreichend Kontrast gut lesbar, tritt aber hinter das Zitat zurück. */
  body.page-home .cenit-hero-home-sub{
    font-weight: 500;
    color: var(--cenit-text);
    opacity: 1;
  }

  /* iPhone/iOS Safari: vh bezieht sich auf die größtmögliche Viewport-Höhe (Toolbars
     ausgeblendet), nicht auf die tatsächlich sichtbare Fläche. Dadurch rutschen Claim +
     Vereinsname unten aus dem Bild, sobald Adress-/Tab-Leiste eingeblendet sind.
     dvh (dynamic viewport height) korrigiert das – Fallback-Wert davor für ältere Browser. */
  @media (max-width: 600px){
    body.page-home .cenit-hero-home-media{
      min-height: 640px;
      min-height: 78dvh;
    }
    body.page-home .cenit-hero-home-top{
      margin-bottom: 0;
    }
    /* Statt mit einem stärkeren Schatten gegenzusteuern (wirkt schnell schmuddelig
       und bringt kaum echten Lesbarkeits-Gewinn): der Claim rutscht durch das kleinere
       margin-bottom tiefer in den bereits stark ausgeblichenen unteren Bereich des
       Verlaufs. Nur ein minimaler heller Schatten als Sicherheitsnetz, kein dunkler Blur. */
    body.page-home .cenit-hero-home-claim{
