---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Zahlen & Fakten – CENIT e.V."
  canonical="https://cenit-ev.de/zahlen-fakten/"
  description="Zahlen und Fakten zu Verletzungsrisiken im Tanz sowie zum wirtschaftlichen Nutzen von Prävention – mit Studien und Quellenangaben."
  bodyClass="page-zahlen-fakten"
>
  <!-- =========================
       HERO EDITORIAL
       ========================= -->
  <section class="cenit-section cenit-zf-hero">
    <div class="cenit-axis-760 reveal" style="--reveal-delay:80ms">
      <h2 class="cenit-h2">
        <span data-lang="de">Zahlen &amp; Fakten</span>
        
      </h2>
      <p class="cenit-editorial-lead">
        <span data-lang="de">Wenn Bewegung zur Belastung wird – warum Prävention im Tanz zählt.</span>
        
      </p>
      <!-- Divider: bitte auf eine definierte Klasse standardisieren -->
      <div class="cenit-divider--gold" aria-hidden="true"></div>
      <div class="cenit-zf-intro">
        <div data-lang="de">
          <p>
            Tanz lebt von Bewegung – doch hinter jeder Perfektion steht tägliche Belastung.
            Viele Tänzer:innen trainieren über ihre Grenzen hinaus, weil Prävention im Tanz
            noch immer kein selbstverständlicher Teil der Ausbildung ist.
          </p>
          <p>
            In diesem Video erklären wir, warum wir uns als gemeinnütziger Verein für eine
            interdisziplinäre, tanzspezifische Prävention einsetzen – und warum nachhaltige
            Prävention ein selbstverständlicher Teil der Tanzausbildung werden muss.
          </p>
        </div>
        
      </div>
    </div>
  </section>
  <!-- =========================
       VIDEO SECTION
       ========================= -->

  <section class="cenit-section cenit-zf-video">
    <div class="cenit-container">
      <div class="cenit-zf-video-inner reveal" style="--reveal-delay:200ms;">
        <div class="cenit-video-frame">
          <!-- DE -->
          <video
            class="cenit-video"
            controls
            playsinline
            preload="metadata"
            poster="/video/still-martha-graham.png"
            data-lang="de"
          >
            <source src="/video/cenit-video-de.mp4" type="video/mp4">
          </video>
          <!-- EN -->
          
        </div>
      </div>
    </div>
  </section>
  <!-- =========================
       CHARTS
       ========================= -->

  <section class="cenit-section cenit-zf-charts">
     <div class="cenit-container">
       <div class="cenit-zf-transition">
         <h2 class="cenit-zf-chapter">
           <span data-lang="de">Verletzungen im Tanz – die Daten sprechen eine deutliche Sprache.</span>
           
         </h2>
       </div>

      <div class="cenit-zf-charts-inner">
        <div class="cenit-facts-grid">
          <!-- Chart 1 -->
          <div class="cenit-embed-card">
            <h3 class="cenit-chart-headline">Dance Injuries - by Cohort</h3>
            <!-- DE -->
            <div class="cenit-embed-consent" data-lang="de">
              <div
                class="cenit-embed-consent-box"
                data-embed-src="https://infogram.com/verletzungsraten-1hmr6g89z0e9z2n"
                data-embed-height="560"
              >
                <p class="cenit-embed-consent-kicker">Zahlen & Fakten</p>
                <p class="cenit-embed-consent-text">
                  Zur Darstellung dieser Daten nutzen wir eine interaktive Grafik.
                  Der Inhalt wird erst nach Ihrer Zustimmung geladen.
                </p>
                <div class="cenit-embed-consent-actions">
                  <button type="button" class="cenit-embed-consent-btn" onclick="loadInfogramEmbed(this)">
                    Grafik anzeigen
                  </button>
                  <a href="/datenschutz/" class="cenit-embed-consent-link">Datenschutz</a>
                </div>
              </div>
              <div class="cenit-zf-sources">
                <strong>Quellen:</strong>
                <a href="https://gots.org/?s=kinder+tanzen" target="_blank" rel="noopener">GOTS</a> ·
                <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC11254869/" target="_blank" rel="noopener">PMC Review</a> ·
                <a href="https://pubmed.ncbi.nlm.nih.gov/33837002/" target="_blank" rel="noopener">PubMed Study</a> ·
                <a href="https://pubmed.ncbi.nlm.nih.gov/39906979/" target="_blank" rel="noopener">PubMed Prospective</a>
              </div>
            </div>
            <!-- EN -->
            
          </div>
          <!-- Chart 2 -->
          <div class="cenit-embed-card">
            <h3 class="cenit-chart-headline">Injury Areas - by Body Region</h3>
            <!-- DE -->
            <div class="cenit-embed-consent" data-lang="de">
              <div
                class="cenit-embed-consent-box"
                data-embed-src="https://infogram.com/verletzungsbereiche-1h7v4pdk85r384k"
                data-embed-height="560"
              >
                <p class="cenit-embed-consent-kicker">Zahlen & Fakten</p>
                <p class="cenit-embed-consent-text">
                  Zur Darstellung dieser Daten nutzen wir eine interaktive Grafik.
                  Der Inhalt wird erst nach Ihrer Zustimmung geladen.
                </p>
                <div class="cenit-embed-consent-actions">
                  <button type="button" class="cenit-embed-consent-btn" onclick="loadInfogramEmbed(this)">
                    Grafik anzeigen
                  </button>
                  <a href="/datenschutz/" class="cenit-embed-consent-link">Datenschutz</a>
                </div>
              </div>
              <div class="cenit-zf-sources">
                <strong>Quellen:</strong>
                <a href="https://pubmed.ncbi.nlm.nih.gov/22390950/" target="_blank" rel="noopener">PubMed Injuries</a> ·
                <a href="https://pubmed.ncbi.nlm.nih.gov/8947396/" target="_blank" rel="noopener">PubMed Injury Patterns</a> ·
                <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC4900039/" target="_blank" rel="noopener">PMC Injury Characteristics</a>
              </div>
            </div>
            <!-- EN -->
            
          </div>
        </div><!-- /.cenit-facts-grid -->
      </div><!-- /.cenit-zf-charts-inner -->
    </div>
  </section>
  <!-- =========================
       ÖKONOMISCHER FALL (für Kostenträger)
       ========================= -->
  <section class="cenit-section cenit-zf-econ" id="kostentraeger">
    <div class="cenit-axis-760">
      <div class="cenit-zf-transition">
        <h2 class="cenit-zf-chapter">
          <span data-lang="de">Prävention rechnet sich – auch für Kostenträger.</span>
          
        </h2>
      </div>

      <p class="cenit-zf-econ-intro">
        <span data-lang="de">
          Verletzungsprävention ist nicht nur eine gesundheitliche, sondern auch eine ökonomische Frage. Für private wie gesetzliche Kostenträger, Berufsgenossenschaften und Versicherer zeigt die Evidenz aus Tanz und Leistungssport: strukturierte Prävention senkt nicht nur das Verletzungsrisiko, sondern auch die Folgekosten.
        </span>
        
      </p>

      <div class="cenit-zf-econ-row">
        <!-- Stat 1: tanzspezifisch -->
        <div class="cenit-zf-econ-card is-dark">
          <p class="cenit-zf-stat-number">−66 %</p>
          <p class="cenit-zf-stat-label">
            <span data-lang="de">Versicherungsfälle</span>
            
          </p>
          <p class="cenit-zf-stat-text">
            <span data-lang="de">In einer professionellen Modern-Dance-Company sank die Zahl neuer Versicherungsfälle über drei Jahre strukturierter Präventions- und Versorgungsarbeit um 66 %, die Ausfalltage um 56 % und die Gesamtverletzungsinzidenz um 34 %.</span>
            
          </p>
          <p class="cenit-zf-stat-source">
            <span data-lang="de">Ojofeitimi &amp; Bronner, <em>J Dance Med Sci</em>, 2011 · <a href="https://doi.org/10.1177/1089313X1101500303" target="_blank" rel="noopener">doi.org/10.1177/1089313X1101500303</a></span>
            
          </p>
        </div>

        <!-- Stat 2: Leistungssport allgemein -->
        <div class="cenit-zf-econ-card">
          <p class="cenit-zf-stat-number">−19 %</p>
          <p class="cenit-zf-stat-label">
            <span data-lang="de">Gesundheitskosten</span>
            
          </p>
          <p class="cenit-zf-stat-text">
            <span data-lang="de">Aus dem Leistungssport allgemein (nicht tanzspezifisch): Ein strukturiertes Präventionsprogramm im US-College-Sport senkte behandlungsbedingte Arztbesuche um 23 % und die damit verbundenen Gesundheitskosten um bis zu 19 %.</span>
            
          </p>
          <p class="cenit-zf-stat-source">
            <span data-lang="de">Parisien et al., <em>Orthop J Sports Med</em>, 2021 · <a href="https://doi.org/10.1177/23259671211029898" target="_blank" rel="noopener">doi.org/10.1177/23259671211029898</a></span>
            
          </p>
        </div>
      </div>

      <p class="cenit-zf-econ-note">
        <span data-lang="de">
          Diese Zahlen stammen aus einzelnen Studien und lassen sich nicht unmittelbar auf jede Institution übertragen – sie zeigen aber eine konsistente Richtung: Investitionen in Prävention amortisieren sich häufig durch geringere Folgekosten. CENIT e.V. steht Kostenträgern, Versicherern und öffentlichen Institutionen für den fachlichen Austausch zu diesem Thema offen gegenüber.
        </span>
        
      </p>

      <p class="cenit-zf-econ-example">
        <span data-lang="de">
          Ein Beispiel aus der Praxis: Die VBG (Verwaltungs-Berufsgenossenschaft), gesetzlicher Unfallversicherungsträger für den Bereich Bühnen und Studios, stellt bereits ein eigenes Ausbildungsmodul zur Unfall- und Verletzungsprävention im Tanz für Lehrkräfte bereit –
          <a href="https://www.vbg.de/cms/buehnen-und-studios/praevention-fuer-tanz" target="_blank" rel="noopener">Prävention für Tanz, VBG
            <svg class="cenit-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </a>.
        </span>
        
      </p>
    </div>
  </section>
  <!-- =========================
       OUTRO / QUOTE BAND
       ========================= -->
  <section class="cenit-section cenit-zf-outro">
    <div class="cenit-axis-760 reveal" style="--reveal-delay:80ms; text-align:center;">
      <h3 class="cenit-zf-quote">
        <span data-lang="de">„Gesund tanzen ist kein Zufall – sondern eine Entscheidung“</span>
        
      </h3>
      <div class="cenit-divider-gold-32" aria-hidden="true"></div>
      <p class="cenit-zf-quote-sub">
        <span data-lang="de">Wir bewegen Wissen – gemeinsam</span>
        
      </p>
    </div>
  </section>

</Layout>

<style>
  /* Ökonomischer Fall / Kostenträger-Sektion (lokal, kein Eingriff in main.css) */
  .cenit-zf-econ-intro{
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0 0 22px 0;
  }

  /* Kachellogik wie FAQ/Glossar: weißer Außenrahmen, helle/dunkle Innenkarten */
  .cenit-zf-econ-row{
    background: #ffffff;
    border-radius: 22px;
    padding: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 18px;
  }
  @media (max-width: 640px){
    .cenit-zf-econ-row{ grid-template-columns: 1fr; }
  }
  .cenit-zf-econ-card{
    background: #f5f3f9;
    border-radius: 18px;
    padding: 20px 22px;
    box-shadow: none;
  }
  .cenit-zf-econ-card.is-dark{ background: #edebf5; }

  .cenit-zf-stat-number{
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 26px;
    line-height: 1;
    color: var(--cenit-purple);
    margin: 0 0 4px 0;
  }
  .cenit-zf-stat-label{
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cenit-gold);
    margin: 0 0 10px 0;
  }
  .cenit-zf-stat-text{
    font-size: 13px;
    line-height: 1.55;
    color: var(--cenit-text);
    margin: 0 0 10px 0;
  }
  .cenit-zf-stat-source{
    font-size: 11.5px;
    font-style: italic;
    color: var(--muted-foreground);
    margin: 0;
  }
  .cenit-zf-econ-note{
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0;
    text-align: center;
  }
  .cenit-zf-econ-example{
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 10px 0 0 0;
    text-align: center;
  }
  .cenit-zf-econ-example a{
    color: var(--cenit-purple);
    text-decoration: none;
    font-weight: 600;
  }
  .cenit-zf-econ-example a:hover{
    text-decoration: underline;
  }
  .cenit-arrow-icon{
    width: 0.85em;
    height: 0.85em;
    margin-left: 4px;
    vertical-align: -0.05em;
    display: inline-block;
  }
</style>
